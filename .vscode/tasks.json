{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run C++",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "problemMatcher": [],
      "dependsOn": "Execute C++",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Execute C++",
      "type": "shell",
      "command": "\"${fileDirname}/${fileBasenameNoExtension}\" < \"${workspaceFolder}/Settingup/input.txt\" > \"${workspaceFolder}/Settingup/output.txt\"",
      "problemMatcher": []
    }
  ]
}